{
  "name": "@perkos/perkos-tech-plugin",
  "version": "0.2.11",
  "description": "PerkOS technology integration for OpenClaw, Hermes, MCP, and AgentSkills-compatible runtimes.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "perkos-tech-mcp": "dist/mcp/server.js"
  },
  "exports": {
    ".": "./dist/src/client.js",
    "./openclaw": "./dist/src/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "py:check": "python3 -c \"import ast,pathlib; [ast.parse(pathlib.Path(p).read_text()) for p in ['hermes/perkos-tech/tools.py','hermes/perkos-tech/schemas.py','skills/perkos-tech/scripts/perkos_tech.py']]\"",
    "smoke": "node scripts/smoke.mjs",
    "mcp": "node dist/mcp/server.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "skills/",
    "hermes/",
    "examples/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "openclaw": ">=2026.5.7"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    }
  }
}
