{
  "plugins": {
    "entries": {
      "perkos-tech": {
        "enabled": true,
        "config": {
          "baseUrl": "https://knowledge.perkos.xyz",
          "sendAgentId": false
        }
      }
    }
  },
  "tools": {
    // Read tools are available by plugin contract. Enable optional write/provider
    // tools only on trusted agents that may create/claim/fulfill/validate requests.
    "allow": [
      "perkos_knowledge_request_create"
      // "perkos_knowledge_request_claim",
      // "perkos_knowledge_request_fulfill",
      // "perkos_knowledge_request_validate"
    ]
  }
}
