{
  "id": "perkos-knowledge",
  "name": "PerkOS Tech",
  "description": "PerkOS Knowledge, x402, ERC-8004 identity, and organization-aware context/request tools for OpenClaw agents.",
  "version": "0.2.13",
  "activation": {
    "onStartup": true
  },
  "skills": [
    "skills"
  ],
  "contracts": {
    "tools": [
      "perkos_knowledge_query",
      "perkos_skill_manifest",
      "perkos_x402_policy",
      "perkos_knowledge_requests_list",
      "perkos_knowledge_request_create",
      "perkos_knowledge_request_claim",
      "perkos_knowledge_request_fulfill",
      "perkos_knowledge_request_validate",
      "perkos_knowledge_submit_research"
    ]
  },
  "toolMetadata": {
    "perkos_knowledge_request_create": {
      "optional": true
    },
    "perkos_knowledge_request_claim": {
      "optional": true
    },
    "perkos_knowledge_request_fulfill": {
      "optional": true
    },
    "perkos_knowledge_request_validate": {
      "optional": true
    },
    "perkos_knowledge_submit_research": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "https://knowledge.perkos.xyz"
      },
      "organizationId": {
        "type": "string"
      },
      "sendAgentId": {
        "type": "boolean",
        "default": false
      },
      "agentWallet": {
        "type": "string"
      },
      "agentErc8004": {
        "type": "string"
      },
      "ingestToken": {
        "type": "string"
      }
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "PerkOS Knowledge base URL"
    },
    "organizationId": {
      "label": "Organization ID"
    },
    "sendAgentId": {
      "label": "Send OpenClaw x-agent-id header"
    },
    "agentWallet": {
      "label": "Agent wallet",
      "sensitive": true
    },
    "agentErc8004": {
      "label": "ERC-8004 identity",
      "sensitive": true
    },
    "ingestToken": {
      "label": "Knowledge ingest/provider token",
      "sensitive": true
    }
  }
}
