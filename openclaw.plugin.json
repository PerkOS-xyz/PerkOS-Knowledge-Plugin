{
  "id": "perkos-tech",
  "name": "PerkOS Tech",
  "description": "PerkOS Knowledge, x402, ERC-8004 identity, and organization-aware context tools for OpenClaw agents.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "skills": ["skills"],
  "contracts": {
    "tools": [
      "perkos_knowledge_query",
      "perkos_skill_manifest",
      "perkos_x402_policy"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "https://knowledge.perkos.xyz"
      },
      "organizationId": {
        "type": "string"
      },
      "sendAgentId": {
        "type": "boolean",
        "default": false
      },
      "agentWallet": {
        "type": "string"
      },
      "agentErc8004": {
        "type": "string"
      }
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "PerkOS Knowledge base URL"
    },
    "organizationId": {
      "label": "Organization ID"
    },
    "sendAgentId": {
      "label": "Send OpenClaw x-agent-id header"
    },
    "agentWallet": {
      "label": "Agent wallet",
      "sensitive": true
    },
    "agentErc8004": {
      "label": "ERC-8004 identity",
      "sensitive": true
    }
  }
}
